{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magnexis FiscalWatch",
  "version": "0.1.0",
  "identifier": "com.magnexis.fiscalwatch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1437",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Magnexis FiscalWatch", "width": 1440, "height": 940, "minWidth": 960, "minHeight": 660 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": []
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
